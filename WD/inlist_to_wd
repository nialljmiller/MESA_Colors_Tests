&star_job
      show_log_description_at_start = .false.

      create_pre_main_sequence_model = .true.

      save_model_when_terminate = .true.
      save_model_filename = 'wd_start.mod'

      history_columns_file = 'history_columns.list'

      pre_ms_relax_num_steps = 50

      load_saved_model = .false.
/

&eos
      use_Skye = .true.
      use_PC = .false.
      Skye_solid_mixing_rule = 'Ogata'
/

&kap
      Zbase = 0.02d0
      kap_file_prefix = 'gs98'
      kap_lowT_prefix = 'lowT_fa05_gs98'
      use_Type2_opacities = .true.
/

&controls
      initial_mass = 1.0d0
      initial_z = 0.02d0
      initial_y = 0.28d0

      default_net_name = 'co_burn_extras.net'

      log_L_lower_limit = 0.0d0
      max_age = 15d9
      max_model_number = 500000

      history_interval = 5
      profile_interval = 100
      terminal_interval = 50
      photo_interval = 500
      photo_digits = 6

      use_gold2_tolerances = .true.
      okay_to_reduce_gradT_excess = .true.

      tol_max_residual1 = 1d-4
      tol_max_residual2 = 1d-4
      tol_max_residual3 = 1d-4

      mesh_delta_coeff = 0.75d0
      time_delta_coeff = 1.0d0
      max_timestep_factor = 1.02d0
      min_timestep_limit = 0d0
      max_number_retries = 1000

      MLT_option = 'Henyey'
      mixing_length_alpha = 1.82d0

      overshoot_scheme(1) = 'exponential'
      overshoot_zone_type(1) = 'burn_H'
      overshoot_zone_loc(1) = 'core'
      overshoot_bdy_loc(1) = 'top'
      overshoot_f(1) = 0.014d0
      overshoot_f0(1) = 0.004d0

      cool_wind_RGB_scheme = 'Reimers'
      Reimers_scaling_factor = 0.5d0
      cool_wind_AGB_scheme = 'Blocker'
      Blocker_scaling_factor = 0.5d0
/
