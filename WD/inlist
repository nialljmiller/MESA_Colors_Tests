! =============================================================================
! STAGE 1: Evolve a 1 Msun star to the white dwarf cooling sequence
! =============================================================================
! This inlist creates a white dwarf by evolving a low-mass star through
! its entire lifetime: pre-MS -> MS -> RGB -> AGB -> PN -> WD
!
! The colors module is DISABLED here to speed up computation.
! Colors will be enabled in Stage 2 (inlist_cool_wd).
!
! Expected runtime: Several hours depending on hardware
! Output: wd_start.mod - a WD model ready for cooling sequence study
! =============================================================================

&star_job
      show_log_description_at_start = .false.

      ! Start from pre-main sequence
      create_pre_main_sequence_model = .true.

      ! Save the WD model for Stage 2
      save_model_when_terminate = .true.
      save_model_filename = 'wd_start.mod'

      ! History columns - include WD-relevant quantities
      history_columns_file = 'history_columns.list'

      ! Relaxation settings
      pre_ms_relax_num_steps = 50

      pgstar_flag = .true.  ! Disable plotting for speed


      load_saved_model = .false.
/


&eos
      ! Skye EOS handles degenerate matter properly
      ! Essential for accurate WD structure
/


&kap
      Zbase = 0.02d0
      kap_file_prefix = 'gs98'
      kap_lowT_prefix = 'lowT_fa05_gs98'
/


&colors
      ! Colors DISABLED for Stage 1 (speed)
      ! Will enable in Stage 2 once WD is formed
      use_colors = .false.
/


&controls
      ! ========================================
      ! INITIAL STELLAR PARAMETERS
      ! ========================================
      ! 1.0 Msun produces a typical ~0.54 Msun WD
      initial_mass = 1.0d0
      initial_z = 0.02d0
      initial_y = 0.28d0

      ! ========================================
      ! STOPPING CONDITION
      ! ========================================
      log_L_lower_limit = -1.5d0
      max_age = 15d9
      max_model_number = 500000

      ! ========================================
      ! OUTPUT CONTROL
      ! ========================================
      history_interval = 5
      profile_interval = 100
      terminal_interval = 50
      photo_interval = 500
      photo_digits = 6

      ! ========================================
      ! NUMERICAL CONTROLS
      ! ========================================
      use_gold2_tolerances = .true.
      okay_to_reduce_gradT_excess = .true.
      
      ! Override specific tolerances for post-AGB
      tol_max_residual1 = 1d-4
      tol_max_residual2 = 1d-4
      tol_max_residual3 = 1d-4
      
      mesh_delta_coeff = 1.0d0
      max_timestep_factor = 1.02
      
      ! CRITICAL: Allow tiny timesteps
      min_timestep_limit = 0
      
      max_number_retries = 1000

      ! ========================================
      ! MIXING AND CONVECTION
      ! ========================================
      mixing_length_alpha = 1.82d0

      overshoot_scheme(1) = 'exponential'
      overshoot_zone_type(1) = 'burn_H'
      overshoot_zone_loc(1) = 'core'
      overshoot_bdy_loc(1) = 'top'
      overshoot_f(1) = 0.014d0
      overshoot_f0(1) = 0.004d0

      ! ========================================
      ! MASS LOSS
      ! ========================================
      cool_wind_RGB_scheme = 'Reimers'
      Reimers_scaling_factor = 0.5d0
      cool_wind_AGB_scheme = 'Blocker'
      Blocker_scaling_factor = 0.5d0

/




&pgstar
      file_white_on_black_flag = .true.
      pgstar_interval = 1

      ! Set up Grid 8 as a 2x2 dashboard layout
      Grid8_win_flag = .true.
      Grid8_win_width = 14
      Grid8_win_aspect_ratio = 0.75  ! Safely scales height relative to width (height / width)
      Grid8_num_cols = 2
      Grid8_num_rows = 2
      Grid8_num_plots = 4

      ! Define panel names matching your working dispatcher setup
      Grid8_plot_name(1) = 'Color_Magnitude1'
      Grid8_plot_name(2) = 'Color_Magnitude2'
      Grid8_plot_name(3) = 'sed1'
      Grid8_plot_name(4) = 'sed2'

      ! --- POSITIONING MATRIX (2x2 Grid) ---
      ! Top-Left: Color-Magnitude Diagram (CMD)
      Grid8_plot_row(1) = 1
      Grid8_plot_col(1) = 1
      Grid8_plot_colspan(1) = 1
      Grid8_plot_rowspan(1) = 1

      ! Top-Right: Hertzsprung-Russell Diagram (HRD)
      Grid8_plot_row(2) = 1
      Grid8_plot_col(2) = 2
      Grid8_plot_colspan(2) = 1
      Grid8_plot_rowspan(2) = 1

      ! Bottom-Left: Custom Native SED Panel
      Grid8_plot_row(3) = 2
      Grid8_plot_col(3) = 1
      Grid8_plot_colspan(3) = 1
      Grid8_plot_rowspan(3) = 1

      ! Bottom-Right: Kippenhahn Diagram
      Grid8_plot_row(4) = 2
      Grid8_plot_col(4) = 2
      Grid8_plot_colspan(4) = 1
      Grid8_plot_rowspan(4) = 1


      ! --- GRID 8 FILE EXPORT CONTROLS ---
      Grid8_file_flag = .true.          ! Enable saving this window to files
      Grid8_file_dir = 'plots'              ! "." tells MESA to save directly into your working directory
      Grid8_file_prefix = 'dashboard_'  ! Filenames will be dashboard_000001.png, dashboard_000002.png, etc.
      Grid8_file_interval = 1           ! Save an image on EVERY single step (set to 5 or 10 to save disk space)

      ! PNG sizing overrides (-1 defaults to your window display dimensions)
      Grid8_file_width = -1
      Grid8_file_aspect_ratio = -1


      ! --- INDIVIDUAL PANEL CONFIGURATIONS ---

      Color_Magnitude1_num_panels = 1
      Color_Magnitude1_xaxis1_name = 'U - I'
      Color_Magnitude1_yaxis1_name = 'V'
      Color_Magnitude1_xaxis_reversed = .true.
      Color_Magnitude1_yaxis_reversed = .true.
      Color_Magnitude1_title = 'Stellar CMD (V vs B-V)'
      Color_Magnitude1_txt_scale = 0.8

      ! 2. color-color

      Color_Magnitude2_num_panels = 1
      Color_Magnitude2_xaxis1_name = 'B - I'
      Color_Magnitude2_yaxis1_name = 'U - B'
      Color_Magnitude2_xaxis_reversed = .true.
      Color_Magnitude2_yaxis_reversed = .true.
      Color_Magnitude2_title = 'Color-Color (U-I vs B-R)'
      Color_Magnitude2_txt_scale = 0.8


      ! 3. Your Custom SED Panel Settings
      SED1_title = 'Live Synthetic Stellar SED'
      SED1_txt_scale = 0.8
      SED1_lambda_min = 100.0
      SED1_lambda_max = 10000.0
      SED1_flux_min = -15.0d0
      SED1_flux_max = 0.0d0
      SED1_filter_scale = 1.0

      ! 4. Your Custom SED Panel Settings
      SED2_title = 'Live Synthetic Stellar SED'
      SED2_txt_scale = 0.8
      SED2_lambda_min = 100.0
      SED2_lambda_max = 30000.0
      SED2_flux_min = -10.0d0
      SED2_flux_max = -101.0d0
      SED2_filter_scale = 0.5

/
