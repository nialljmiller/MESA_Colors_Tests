@article{AGomez-Gonzalez2021,
  title        = {{Planetary nebulae with Wolf-Rayet-type central stars-III. A detailed view of NGC 6905 and its central star}},
  author       = {{A G{\'{o}}mez-Gonz{\'{a}}lez}, V M and Rubio, G and Toal{\'{a}}, J A and Guerrero, M A and Sabin, L and Todt, H and G{\'{o}}mez-Llanos, V and Ramos-Larios, G and Mayya, Y D},
  year         = 2021,
  journal      = {MNRAS},
  volume       = {000},
  url          = {http://www.not.iac.es/instruments/alfosc/},
  abstract     = {We present a multi-wavelength characterisation of the planetary nebula (PN) NGC 6905 and its [Wolf-Rayet]-type ([WR]) central star (CSPN) HD 193949. Our Nordic Optical Telescope (NOT) Alhambra Faint Object Spectrograph and Camera (ALFOSC) spectra and images unveil in unprecedented detail the high-ionization structure of NGC 6905. The high-quality spectra of HD 193949 allowed us to detect more than 20 WR features including the characteristic O-bump, blue bump and red bump, which suggests a spectral type no later than a [WO2]-subtype. Moreover we detect the Ne and Ne broad emission lines, rendering HD 193949 yet another CSPN with {\'{i}} µ{\'{i}}± eff 150 kK exhibiting such stellar emission lines. We studied the physical properties ({\'{i}} µ{\'{i}}± e and {\'{i}} µ{\'{i}}± e) and chemical abundances of different regions within NGC 6905 including its low-ionization clumps; abundances are found to be homogeneous. We used the PoWR stellar atmosphere code to model the spectrum of HD 193949, which is afterwards used in a photoionization model performed with CCCCCC that reproduces the nebular and dust properties for a total mass in the 0.31-0.47 M range and a mass of C-rich dust of ∼2 ×10 −3 M. Adopting a current stellar mass of 0.6 M , our model suggests an initial mass ∼1 M for HD 193949, consistent with the observations.},
  archiveprefix = {arXiv},
