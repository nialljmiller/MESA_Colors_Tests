  author       = {Oliveira, A S and Rodrigues, C V and Cieslinski, D and Jablonski, F J and Silva, K M G and Almeida, L A and Rodr{\'{i}}guez-Ardila, A and Palhares, M S},
  year         = 2017,
  journal      = {The Astronomical Journal},
